<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Happy Birthday Azeezah Adebanke 🎂</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <main class="birthday-container">

        <!-- Floating decorations -->
        <div class="floating-hearts">
            💗 🩵 ✨ 💕 ✨ 🩵 💗
        </div>

        <!-- Hero -->
        <section class="hero">

            <p class="small-text">
                A little surprise made especially for you 💌
            </p>

            <h1>
                Happy Birthday<br>
                <span>Azeezah Adebanke</span> 🎂
            </h1>

            <p class="intro">
                Today is a beautiful day because someone
                truly special was born. 💗
            </p>

            <button id="surpriseBtn">
                Open Your Surprise 🎁
            </button>

        </section>


        <!-- Birthday Countdown -->
        <section class="countdown-section">

            <p class="small-text">
                Your special day is coming ✨
            </p>

            <h2>🎂 Birthday Countdown</h2>

            <div id="countdown">

                <div class="time-box">
                    <span id="days">00</span>
                    <small>Days</small>
                </div>

                <div class="time-box">
                    <span id="hours">00</span>
                    <small>Hours</small>
                </div>

                <div class="time-box">
                    <span id="minutes">00</span>
                    <small>Minutes</small>
                </div>

                <div class="time-box">
                    <span id="seconds">00</span>
                    <small>Seconds</small>
                </div>

            </div>

        </section>


        <!-- Birthday Message -->
        <section id="message" class="hidden">

            <div class="card">

                <h2>💖 A Birthday Message</h2>

                <p>
                    Dear Azeezah,
                </p>

                <p>
                    Happy Birthday to an amazing person! 🎉
                    May this new chapter of your life bring you
                    happiness, peace, success and countless
                    beautiful memories.
                </p>

                <p>
                    You deserve to smile today, tomorrow and
                    every day after that. Never forget how
                    special you are. 🌸
                </p>

                <p class="signature">
                    From your bestie ❤️
                </p>

            </div>

        </section>

        <!-- Memories -->
        <section class="memories">

            <h2>💕</h2>

            <div class="gallery">

                <div class="photo-card">
                    <img src="Azeezah(1).png " alt="Azeezah">
                    <p>Beautiful smile ❤️</p>
                </div>

                <div class="photo-card">
                    <img src="Azeezah(2).png" alt="Azeezah">
                    <p>Modesty is beauty 💗✨</p>
                </div>

                <div class="photo-card">
                    <img src="Azeezah(3).png" alt="Azeezah">
                    <p>Keep smiling 💕</p>
                </div>

            </div>

        </section>
        <!-- Birthday Message -->

<section id="message" class="hidden">

    <div class="card">

        <h2>💌 A Special Message For You</h2>

        <p>
            Happy birthday to you dear 💗🎉🎊
        </p>

        <p>
            Wishing you long life, joy, peace of mind,
            a strong heart and beautiful future 💥
        </p>

        <p>
            May Allah bless your new age with Iman,
            good health, and endless barakah.
        </p>

        <p class="signature">
            Ameen! 🤲🙏
        </p>

    </div>

</section>


<!-- Final Surprise -->

<section class="final-surprise">

    <p class="small-text">
        One last thing for you 💌
    </p>

    <h2>🎁 One Last Surprise</h2>

    <p class="surprise-text">
        You thought that was everything? 😄
        There's still one little surprise waiting for you.
    </p>

    <button id="finalSurpriseBtn">
        Open My Last Surprise 💖
    </button>

    <div id="finalMessage" class="final-message hidden">

        <div class="final-heart">
            💗
        </div>

        <h3>Never Stop Being You ✨</h3>

        <p>
            Azeezah, always remember that you are
            beautiful, valuable wonderfully unique and always remember that MB loves u 💗.
        </p>

        <p>
         Enjoy your day to the fullest dear 💗🎉🎊
Wishing you long life, joy, peace of mind, a strong heart and beautiful future 💥
May Allah bless your new age with Iman, good health, and endless barakah.
Ameen! 🤲🙏.
        </p>

        <p class="final-signature">
            Happy Birthday once again! 🎂💗🩵
        </p>

    </div>

</section>
<!-- Footer -->

<footer class="birthday-footer">

    <div class="footer-heart">
        💗
    </div>

    <h2>Happy Birthday, Azeezah! 🎂</h2>

    <p>
        May your days always be filled with
        happiness, peace, love and beautiful memories. ✨
    </p>

    <div class="footer-line"></div>

    <small>
        Made with 💗 specially for Azeezah Adebanke
    </small>

</footer>
    </main>

    <script src="script.js"></script>

</body>
</html>
